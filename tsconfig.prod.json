{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": undefined
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/setupTests.ts"
  ]
}
